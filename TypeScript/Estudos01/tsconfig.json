{
    "compilerOptions": {
        "target": "esnext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "jsx": "react-jsx",
        "allowJs": true,
        "noImplicitAny": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": [
            "node"
        ],
        "sourceMap": true,
    },
    "include": [
        "src/**/*",
        "webpack.config.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}